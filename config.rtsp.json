{
  "input": {
    "mode": "rtsp",
    "video_path": "data/sample4.mp4",
    "rtsp_url": "rtsp://username:password@192.168.1.10:554/stream1",
    "reconnect_attempts": 10,
    "reconnect_delay_sec": 3
  },
  "detection": {
    "model_path": "models/yolov8n-face.pt",
    "conf_threshold": 0.4,
    "imgsz": 640,
    "device": "auto",
    "detection_skip_frames": 3
  },
  "recognition": {
    "model_name": "buffalo_l",
    "similarity_threshold": 0.45,
    "gallery_update_threshold": 0.6,
    "min_samples": 3,
    "max_attempts": 20,
    "min_face_size": 30,
    "min_sharpness": 5.0,
    "crop_margin": 0.3
  },
  "tracking": {
    "iou_threshold": 0.3,
    "max_lost_frames": 30,
    "min_hits": 2
  },
  "storage": {
    "db_path": "data/visitors.db",
    "logs_dir": "logs",
    "log_file": "logs/events.log",
    "reset_on_start": true
  },
  "output": {
    "show_window": true,
    "annotated_video_path": "",
    "stats_every_n_frames": 100
  }
}
